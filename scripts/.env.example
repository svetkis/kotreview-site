# Скопируй в scripts/.env и заполни. .env не коммитится.
# ID группы VK: числовой (ID из настроек сообщества, без минуса) или короткое имя, например kot_review
VK_GROUP_ID=kot_review

# Ключ доступа сообщества: Управление сообществом -> Работа с API -> Ключи доступа.
# Нужны права: «Стена» (wall) и «Документы» (docs); в группе должен быть включён раздел «Документы».
VK_COMMUNITY_TOKEN=

# Опционально: адрес сайта для ссылок в футере постов
SITE_URL=https://kotreview.ru
