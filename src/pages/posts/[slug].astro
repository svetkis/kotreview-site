---
import { existsSync } from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// og-картинка для карточек ссылок (VK/Telegram): обложка 1200x630 (ASCII-имя),
// иначе первая картинка поста, иначе общий баннер сайта
const firstMedia = post.body?.match(/\]\((\/images\/[^)]+)\)/)?.[1];
const coverName = firstMedia?.split('/').pop();
const ogCover =
  coverName && existsSync(`public/images/og/${coverName}`) ? `/images/og/${coverName}` : undefined;
const firstImage = ogCover ?? post.data.image ?? firstMedia ?? undefined;
---

<Layout title={`${post.data.title} — KotReview`} description={post.data.description} image={firstImage}>
  <article class="container">
    <h1>{post.data.title}</h1>
    <div class="meta" style="margin-bottom: 1.5rem;">
      <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ru-RU')}</time>
      {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    {post.data.source && (
      <p>
        <a href={post.data.source} target="_blank" rel="noopener">Источник →</a>
      </p>
    )}
    <Content />
    <p style="margin-top: 2rem;"><a href="/posts">← Назад к записям</a></p>
  </article>
</Layout>
