---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const links = (await getCollection('links'))
  .filter((l) => !l.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

// Порядок секций задаётся здесь; новые секции из контента добавляются в конец по алфавиту
const SECTION_ORDER = ['Канал и соцсети', 'Боты и проекты'];
const sections = [...new Set(links.map((l) => l.data.section))].sort((a, b) => {
  const ia = SECTION_ORDER.indexOf(a);
  const ib = SECTION_ORDER.indexOf(b);
  return (ia === -1 ? SECTION_ORDER.length : ia) - (ib === -1 ? SECTION_ORDER.length : ib) || a.localeCompare(b);
});
---

<Layout title="Ссылки — KotReview" description="Каталог ссылок Светланы Мелешкиной: Telegram-канал, боты, проекты, доклады и статьи.">
  <div class="container">
    <section class="links-hero">
      <img class="links-photo" src="/images/author.jpg" alt="Светлана Мелешкина" width="112" height="112" />
      <div class="links-hero-text">
        <h1>Светлана Мелешкина</h1>
        <p>.NET · AI engineering · агенты</p>
      </div>
    </section>

    {sections.map((section) => (
      <section class="links-section" aria-labelledby={`section-${section.replace(/\s+/g, '-')}`}>
        <h2 id={`section-${section.replace(/\s+/g, '-')}`}>{section}</h2>
        <ul class="links-list">
          {links
            .filter((l) => l.data.section === section)
            .map((l) => {
              const internal = l.data.url.startsWith('/');
              return (
                <li>
                  <a
                    class={`link-row${l.data.featured ? ' link-row-featured' : ''}`}
                    href={l.data.url}
                    target={internal ? undefined : '_blank'}
                    rel={internal ? undefined : 'noopener'}
                  >
                    <span class="link-emoji" aria-hidden="true">{l.data.emoji}</span>
                    <span class="link-body">
                      <span class="link-title">{l.data.title}</span>
                      {l.data.description && <span class="link-desc">{l.data.description}</span>}
                    </span>
                    <span class="link-arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              );
            })}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .links-hero {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.5rem 0 1.75rem;
  }

  .links-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
    box-shadow: 0 0 24px rgba(245, 158, 11, 0.12);
    flex-shrink: 0;
  }

  .links-hero-text h1 {
    font-size: 1.6rem;
    line-height: 1.2;
    margin: 0 0 0.25rem;
  }

  .links-hero-text p {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .links-section {
    margin-bottom: 2rem;
  }

  .links-section h2 {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .link-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 64px;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .link-row:hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .link-emoji {
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
    width: 2.2rem;
    text-align: center;
  }

  .link-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .link-title {
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .link-desc {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .link-arrow {
    color: var(--muted);
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .link-row:hover .link-arrow {
    color: var(--accent);
  }

  /* Выделенная карточка (featured: true) — стикерпак и т.п. */
  .link-row-featured {
    border-color: var(--accent);
    background: rgba(245, 158, 11, 0.07);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.1);
  }

  .link-row-featured .link-title {
    color: var(--accent);
  }

  .link-row-featured .link-arrow {
    color: var(--accent);
  }

  /* На широких экранах каталог остаётся узким — как на телефоне, только с воздухом */
  .links-hero,
  .links-section {
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 640px) {
    .links-photo {
      width: 112px;
      height: 112px;
    }

    .links-hero-text h1 {
      font-size: 1.9rem;
    }
  }
</style>
